# Caddy henter og fornyer SSL-sertifikat automatisk via Let's Encrypt.
{$DOMAIN} {
    reverse_proxy app:3000

    header {
        # Clickjacking-vern
        X-Frame-Options "SAMEORIGIN"

        # Forhindrer MIME-type sniffing
        X-Content-Type-Options "nosniff"

        # Referrer: send full URL til eget domene, kun opprinnelse til andre
        Referrer-Policy "strict-origin-when-cross-origin"

        # Slå av nettleserfunksjoner vi ikke bruker
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # HSTS — ett år. Legg til preload + includeSubDomains etter testing.
        Strict-Transport-Security "max-age=31536000"

        # Fjern server-identifikasjon
        -Server

        # -----------------------------------------------------------------------
        # Content-Security-Policy (ENFORCED)
        #
        # Treff akseptert av design:
        #   script-src 'unsafe-inline'  — Next.js __NEXT_DATA__ hydration
        #   style-src  'unsafe-inline'  — Payload-admin + ev. inline styles
        #
        # Klientside img-src utenom 'self':
        #   Webkamera (6 domener, WebcamWeatherClient):
        #     weathercam.herokuapp.com    — Brønnøysunds Avis
        #     webcam.havbrukssenter.no    — Norsk Havbrukssenter
        #     www.velfjordferie.no        — Velfjordferie
        #     ftp.hald-ikt.no             — Alstahaug / Båtforeningen
        #     kamera.atlas.vegvesen.no    — Vegvesenet
        #     infohelgeland.no            — Mosjøen Båtforening
        #   Nyhetsbilder (NewsWidget/NewsCarousel — servert via <img> i browser):
        #     vcdn.polarismedia.no        — BAnett artikkelbilder (Polaris CDN)
        #     www.hblad.no                — Helgelands Blad (WordPress)
        #     gfx.nrk.no                  — NRK artikkelbilder
        #     static.nrk.no               — NRK statiske bilder
        #
        # Klientside connect-src utenom 'self':
        #   api.open-meteo.com  — vær (WebcamWeatherClient, 30 min klient-cache)
        #   date.nager.at       — helligdager (CalendarClient, ved månedsskifte)
        #
        # Politilogg, anbud, regnskap, BRREG, NAV, Avinor, strøm, valuta —
        # alle hentes server-side (async RSC). Ingen CSP-kilde nødvendig.
        #
        # ForsideSearch: kaller /api/sok = 'self'. OK.
        #
        # frame-src:
        #   www.openstreetmap.org  — kart-iframe på /bedrifter/[slug]
        #   nais.kystverket.no     — skipstrafikk-widget
        # -----------------------------------------------------------------------
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://weathercam.herokuapp.com https://webcam.havbrukssenter.no https://www.velfjordferie.no https://ftp.hald-ikt.no https://kamera.atlas.vegvesen.no https://infohelgeland.no https://vcdn.polarismedia.no https://www.hblad.no https://gfx.nrk.no https://static.nrk.no; connect-src 'self' https://api.open-meteo.com https://date.nager.at; frame-src https://www.openstreetmap.org https://nais.kystverket.no; font-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    }
}
