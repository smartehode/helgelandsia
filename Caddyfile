# Caddy henter og fornyer SSL-sertifikat automatisk via Let's Encrypt.
{$DOMAIN} {
    reverse_proxy app:3000

    header {
        # Clickjacking-vern
        X-Frame-Options "SAMEORIGIN"

        # Forhindrer MIME-type sniffing
        X-Content-Type-Options "nosniff"

        # Referrer: send full URL til eget domene, kun opprinnelse til andre
        Referrer-Policy "strict-origin-when-cross-origin"

        # Slå av nettleserfunksjoner vi ikke bruker
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # HSTS — ett år. Legg til preload + includeSubDomains etter testing.
        Strict-Transport-Security "max-age=31536000"

        # Fjern server-identifikasjon
        -Server

        # -----------------------------------------------------------------------
        # Content-Security-Policy-Report-Only
        #
        # Kjøres i observasjonsmodus — ingenting blokkeres, men brudd rapporteres
        # til nettleserkonsollen (og evt. report-uri). Bytt til
        # Content-Security-Policy når vi er trygge på at ingenting knekker.
        #
        # Treff å forvente (og som er akseptert):
        #   script-src 'unsafe-inline'  — Next.js __NEXT_DATA__ hydration
        #   style-src  'unsafe-inline'  — Payload-admin + ev. inline styles
        #
        # Klientside img-src utenom 'self':
        #   Webkameraene i WebcamWeatherWidget (6 faste domener)
        #
        # Klientside connect-src utenom 'self':
        #   api.open-meteo.com  — vær (WebcamWeatherClient)
        #   date.nager.at       — helligdager (CalendarClient)
        #
        # frame-src:
        #   www.openstreetmap.org — kart-iframe på /bedrifter/[slug]
        # -----------------------------------------------------------------------
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://weathercam.herokuapp.com https://webcam.havbrukssenter.no https://www.velfjordferie.no https://ftp.hald-ikt.no https://kamera.atlas.vegvesen.no https://infohelgeland.no; connect-src 'self' https://api.open-meteo.com https://date.nager.at; frame-src https://www.openstreetmap.org; font-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    }
}
